import { Theme, Motion } from "../theme.slint";
import { WifiNetwork, BtDevice, AudioDevice, CalCell, CalEvent, Fact } from "../types.slint";
import { Symbol } from "icon.slint";
import { GlassPlate } from "surfaces.slint";
import { Switch, Slider, Segmented, PillButton, IconButton, Ring } from "controls.slint";
import { ListRow, SectionLabel, FootLink, Rule, Scroller } from "lists.slint";
import { CalendarGrid } from "calendar.slint";

// The frame every popover shares: glass that grows out of the bar item it belongs to (the pointer's
// place on the bar is `origin-x`, in the card's own coordinates) and shrinks back into it.
export component PopCard inherits Rectangle {
    in property <bool> open: false;
    in property <length> origin-x: 0px;

    property <float> amount: open ? 1 : 0;
    animate amount {
        duration: open ? Motion.pop-in : Motion.pop-out;
        easing: open ? cubic-bezier(0.34, 1.35, 0.64, 1) : cubic-bezier(0.4, 0, 1, 1);
    }
    visible: amount > 0.01;
    opacity: min(amount, 1.0);
    transform-scale: 0.88 + 0.12 * amount;
    transform-origin: { x: root.origin-x, y: 0px };

    GlassPlate {
        width: parent.width;
        height: parent.height;
    }
    // A press on the card's own surface is the card's: it must not reach the click-away behind it.
    TouchArea {}
    @children
}

// A heading with a switch on its right: "Wi-Fi", "Bluetooth".
component SwitchHeader inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in-out property <bool> checked;
    callback toggled(bool);
    height: 44px;
    Text {
        x: 6px;
        y: root.subtitle != "" ? 4px : (parent.height - self.height) / 2;
        text: root.title;
        color: Theme.text;
        font-size: 15px;
        font-weight: 700;
    }
    if root.subtitle != "": Text {
        x: 6px;
        y: 24px;
        text: root.subtitle;
        color: Theme.text-2;
        font-size: 11.5px;
    }
    Switch {
        x: parent.width - self.width - 6px;
        y: (parent.height - self.height) / 2;
        checked <=> root.checked;
        toggled(c) => {
            root.toggled(c);
        }
    }
}

// What a list says when there is nothing to list.
component EmptyState inherits Rectangle {
    in property <string> icon;
    in property <string> text;
    Symbol {
        x: (parent.width - self.width) / 2;
        y: parent.height / 2 - 30px;
        width: 28px;
        height: 28px;
        name: root.icon;
        tint: Theme.text-3;
    }
    Text {
        x: 0px;
        y: parent.height / 2 + 6px;
        width: parent.width;
        text: root.text;
        horizontal-alignment: center;
        color: Theme.text-2;
        font-size: 13px;
    }
}

export component WifiPopover inherits PopCard {
    in-out property <bool> enabled: true;
    in property <[WifiNetwork]> networks;
    callback toggled(bool);
    callback network-clicked(int);
    callback settings();

    property <length> list-h: enabled && networks.length > 0 ? min(networks.length, 6) * 46px + 2px : 96px;
    width: 330px;
    height: list-h + 108px;

    VerticalLayout {
        x: 10px;
        y: 10px;
        width: parent.width - 20px;
        height: parent.height - 20px;
        spacing: 3px;
        SwitchHeader {
            title: "Wi-Fi";
            subtitle: !root.enabled ? "Off" : root.networks.length > 0 ? "" : "Looking for networks…";
            checked <=> root.enabled;
            toggled(c) => {
                root.toggled(c);
            }
        }
        Rule {}
        Rectangle {
            height: root.list-h;
            if !root.enabled || root.networks.length == 0: EmptyState {
                icon: root.enabled ? "wifi-1" : "wifi-off";
                text: root.enabled ? "No networks in range" : "Wi-Fi is turned off";
            }
            if root.enabled && root.networks.length > 0: Scroller {
                inner-height: root.networks.length * 46px;
                VerticalLayout {
                    width: parent.width;
                    for n[i] in root.networks: ListRow {
                        icon: n.strength >= 3 ? "wifi-3" : n.strength == 2 ? "wifi-2" : "wifi-1";
                        title: n.name;
                        subtitle: n.connected ? "Connected" : n.connecting ? "Connecting…" : n.saved ? "Saved" : n.secured ? "Secured" : "Open";
                        active: n.connected;
                        trailing: n.connecting ? "spinner" : n.connected ? "check" : n.secured ? "lock" : "";
                        clicked => {
                            root.network-clicked(i);
                        }
                    }
                }
            }
        }
        Rule {}
        FootLink {
            text: "Wi-Fi Settings…";
            clicked => {
                root.settings();
            }
        }
    }
}

export component BluetoothPopover inherits PopCard {
    in-out property <bool> enabled: true;
    in property <[BtDevice]> devices;
    callback toggled(bool);
    callback device-clicked(int);
    callback settings();

    property <length> list-h: enabled && devices.length > 0 ? min(devices.length, 6) * 46px + 2px : 96px;
    width: 330px;
    height: list-h + 108px;

    VerticalLayout {
        x: 10px;
        y: 10px;
        width: parent.width - 20px;
        height: parent.height - 20px;
        spacing: 3px;
        SwitchHeader {
            title: "Bluetooth";
            subtitle: !root.enabled ? "Off" : "";
            checked <=> root.enabled;
            toggled(c) => {
                root.toggled(c);
            }
        }
        Rule {}
        Rectangle {
            height: root.list-h;
            if !root.enabled || root.devices.length == 0: EmptyState {
                icon: "bluetooth";
                text: root.enabled ? "No devices nearby" : "Bluetooth is turned off";
            }
            if root.enabled && root.devices.length > 0: Scroller {
                inner-height: root.devices.length * 46px;
                VerticalLayout {
                    width: parent.width;
                    for d[i] in root.devices: ListRow {
                        icon: d.icon;
                        title: d.name;
                        subtitle: d.connecting ? "Connecting…" : d.connected ? (d.battery >= 0 ? "Connected · " + d.battery + "%" : "Connected") : "Not connected";
                        active: d.connected;
                        trailing: d.connecting ? "spinner" : d.connected ? "check" : "";
                        clicked => {
                            root.device-clicked(i);
                        }
                    }
                }
            }
        }
        Rule {}
        FootLink {
            text: "Bluetooth Settings…";
            clicked => {
                root.settings();
            }
        }
    }
}

export component BatteryPopover inherits PopCard {
    in property <int> percent: 80;
    in property <bool> charging: false;
    // "Charging" / "On battery" / "Fully charged"
    in property <string> status: "On battery";
    // "38 min until full", "3 h 12 min remaining"
    in property <string> detail: "";
    // "Power adapter", "Battery"
    in property <string> source: "";
    in property <[string]> modes: ["Saver", "Balanced", "Performance"];
    in-out property <int> mode: 1;
    in property <[Fact]> facts;
    callback mode-picked(int);
    callback settings();

    width: 308px;
    height: 12px + 92px + 2px + 24px + 30px + 12px + (facts.length > 0 ? 62px : 0px) + 6px + 34px + 12px;

    Rectangle {
        x: 16px;
        y: 16px;
        width: 76px;
        height: 76px;
        Ring {
            width: parent.width;
            height: parent.height;
            value: root.percent / 100.0;
            tone: root.charging ? Theme.ok : root.percent <= 15 ? Theme.danger : Theme.accent;
            thickness: 7px;
        }
        Text {
            width: parent.width;
            height: parent.height;
            text: root.percent + "%";
            horizontal-alignment: center;
            vertical-alignment: center;
            font-size: 20px;
            font-weight: 700;
            color: Theme.text;
        }
    }
    Text {
        x: 108px;
        y: 24px;
        width: parent.width - 124px;
        text: root.status;
        font-size: 16px;
        font-weight: 700;
        color: Theme.text;
        overflow: elide;
    }
    Text {
        x: 108px;
        y: 47px;
        width: parent.width - 124px;
        text: root.detail;
        font-size: 12.5px;
        color: Theme.text-2;
        overflow: elide;
    }
    if root.source != "": Rectangle {
        x: 108px;
        y: 69px;
        height: 20px;
        width: src.preferred-width + 30px;
        border-radius: 10px;
        background: Theme.field;
        Symbol {
            x: 6px;
            y: 4px;
            width: 12px;
            height: 12px;
            name: root.charging ? "plug" : "lightning";
            tint: Theme.text-2;
        }
        src := Text {
            x: 22px;
            height: parent.height;
            text: root.source;
            font-size: 11px;
            color: Theme.text-2;
            vertical-alignment: center;
        }
    }
    VerticalLayout {
        x: 16px;
        y: 106px;
        width: parent.width - 32px;
        spacing: 0px;
        SectionLabel {
            text: "POWER MODE";
        }
        Segmented {
            labels: root.modes;
            current <=> root.mode;
            picked(i) => {
                root.mode-picked(i);
            }
        }
    }
    if root.facts.length > 0: Rectangle {
        x: 16px;
        y: 106px + 24px + 30px + 12px;
        width: parent.width - 32px;
        height: 50px;
        for f[i] in root.facts: Rectangle {
            x: i * (parent.width / root.facts.length);
            width: parent.width / root.facts.length - 8px;
            border-radius: Theme.radius-medium;
            background: Theme.field;
            Text {
                x: 12px;
                y: 9px;
                text: f.label;
                font-size: 11px;
                color: Theme.text-2;
            }
            Text {
                x: 12px;
                y: 25px;
                text: f.value;
                font-size: 15px;
                font-weight: 700;
                color: Theme.text;
            }
        }
    }
    FootLink {
        x: 10px;
        y: parent.height - 46px;
        width: parent.width - 20px;
        text: "Battery Settings…";
        clicked => {
            root.settings();
        }
    }
}

export component VolumePopover inherits PopCard {
    in-out property <float> volume: 0.5;
    in-out property <bool> muted: false;
    in property <[AudioDevice]> outputs;
    callback volume-edited(float);
    callback mute-toggled(bool);
    callback output-clicked(int);
    callback settings();

    width: 320px;
    height: 10px + 44px + 46px + 6px + (outputs.length > 0 ? 24px + outputs.length * 40px + 8px : 0px) + 34px + 12px;

    Text {
        x: 16px;
        y: 14px;
        text: "Sound";
        font-size: 15px;
        font-weight: 700;
        color: Theme.text;
    }
    Text {
        x: parent.width - self.preferred-width - 16px;
        y: 17px;
        text: root.muted ? "Muted" : round(root.volume * 100) + "%";
        font-size: 12.5px;
        color: Theme.text-2;
    }
    Rectangle {
        x: 12px;
        y: 54px;
        width: parent.width - 24px;
        height: 36px;
        IconButton {
            x: 0px;
            y: 4px;
            icon: root.muted || root.volume <= 0.001 ? "volume-mute" : "volume-0";
            strong: true;
            clicked => {
                root.muted = !root.muted;
                root.mute-toggled(root.muted);
            }
        }
        Slider {
            x: 36px;
            y: 7px;
            width: parent.width - 36px - 36px;
            value <=> root.volume;
            enabled: !root.muted;
            edited(v) => {
                root.volume-edited(v);
            }
        }
        Symbol {
            x: parent.width - 28px;
            y: 9px;
            width: 18px;
            height: 18px;
            name: "volume-2";
            tint: Theme.text-2;
        }
    }
    if root.outputs.length > 0: VerticalLayout {
        x: 10px;
        y: 98px;
        width: parent.width - 20px;
        spacing: 0px;
        SectionLabel {
            text: "OUTPUT";
            x: 6px;
        }
        for o[i] in root.outputs: ListRow {
            icon: o.icon;
            title: o.name;
            active: o.selected;
            trailing: o.selected ? "check" : "";
            clicked => {
                root.output-clicked(i);
            }
        }
    }
    FootLink {
        x: 10px;
        y: parent.height - 46px;
        width: parent.width - 20px;
        text: "Sound Settings…";
        clicked => {
            root.settings();
        }
    }
}

// One event: a bar in its colour, the time, the title and where.
component EventRow inherits Rectangle {
    in property <CalEvent> event;
    height: 46px;
    Rectangle {
        x: 6px;
        y: 7px;
        width: 4px;
        height: parent.height - 14px;
        border-radius: 2px;
        background: Theme.tone(root.event.tone);
    }
    Text {
        x: 20px;
        y: 7px;
        width: parent.width - 28px;
        text: root.event.title;
        font-size: 13.5px;
        font-weight: 600;
        color: Theme.text;
        overflow: elide;
    }
    Text {
        x: 20px;
        y: 25px;
        width: parent.width - 28px;
        text: root.event.place != "" ? root.event.time + "  ·  " + root.event.place : root.event.time;
        font-size: 11.5px;
        color: Theme.text-2;
        overflow: elide;
    }
}

export component CalendarPopover inherits PopCard {
    in property <string> title: "";
    in property <[string]> weekdays;
    in property <[CalCell]> cells;
    in property <string> day-title: "";
    in property <[CalEvent]> events;
    callback previous();
    callback next();
    callback today();
    callback picked(int);
    callback open-calendar();

    property <length> events-h: events.length > 0 ? min(events.length, 3) * 46px : 56px;
    width: 352px;
    height: 12px + 44px + (24px + 6 * 36px) + 8px + 1px + 30px + events-h + 6px + 34px + 20px;

    Text {
        x: 20px;
        y: 22px;
        text: root.title;
        font-size: 17px;
        font-weight: 700;
        color: Theme.text;
    }
    IconButton {
        x: parent.width - 28px - 12px - 52px - 4px - 28px - 4px;
        y: 18px;
        icon: "chevron-left";
        clicked => {
            root.previous();
        }
    }
    PillButton {
        x: parent.width - 12px - 28px - 4px - 52px;
        y: 18px;
        width: 52px;
        height: 28px;
        pad: 0px;
        text: "Today";
        clicked => {
            root.today();
        }
    }
    IconButton {
        x: parent.width - 12px - 28px;
        y: 18px;
        icon: "chevron-right";
        clicked => {
            root.next();
        }
    }
    CalendarGrid {
        x: 12px;
        y: 56px;
        width: parent.width - 24px;
        cells: root.cells;
        weekdays: root.weekdays;
        picked(i) => {
            root.picked(i);
        }
    }
    Rule {
        x: 16px;
        y: 56px + 24px + 6 * 36px + 8px;
        width: parent.width - 32px;
    }
    Text {
        x: 20px;
        y: 56px + 24px + 6 * 36px + 8px + 1px + 8px;
        text: root.day-title;
        font-size: 12.5px;
        font-weight: 700;
        color: Theme.text-2;
    }
    Rectangle {
        x: 12px;
        y: 56px + 24px + 6 * 36px + 8px + 1px + 30px;
        width: parent.width - 24px;
        height: root.events-h;
        if root.events.length == 0: Text {
            width: parent.width;
            height: parent.height;
            text: "Nothing planned";
            horizontal-alignment: center;
            vertical-alignment: center;
            font-size: 13px;
            color: Theme.text-3;
        }
        if root.events.length > 0: Scroller {
            inner-height: root.events.length * 46px;
            VerticalLayout {
                width: parent.width;
                for e in root.events: EventRow {
                    event: e;
                }
            }
        }
    }
    FootLink {
        x: 10px;
        y: parent.height - 46px;
        width: parent.width - 20px;
        text: "Open Calendar";
        icon: "calendar";
        clicked => {
            root.open-calendar();
        }
    }
}
