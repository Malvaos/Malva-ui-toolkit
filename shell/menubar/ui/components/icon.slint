        : name == "plug" ? @image-url("../icons/symbols/plug.svg")
        : name == "plus" ? @image-url("../icons/symbols/plus.svg")
        : name == "power" ? @image-url("../icons/symbols/power.svg")
        : name == "previous" ? @image-url("../icons/symbols/previous.svg")
