import { Theme } from "../theme.slint";

// Generated by tools/make-symbols.py from the files in ui/icons: do not edit by hand.

// A coloured picture by name: an app's tile, or a weather picture. Unknown names show "default".
export component AppIcon inherits Image {
    in property <string> name;
    in property <image> system-image;
    in property <bool> has-system-image: false;
    image-fit: contain;
    source: has-system-image ? system-image
        : name == "browser" ? @image-url("../icons/app/browser.svg")
        : name == "calculator" ? @image-url("../icons/app/calculator.svg")
        : name == "calendar" ? @image-url("../icons/app/calendar.svg")
        : name == "default" ? @image-url("../icons/app/default.svg")
        : name == "editor" ? @image-url("../icons/app/editor.svg")
        : name == "files" ? @image-url("../icons/app/files.svg")
        : name == "mail" ? @image-url("../icons/app/mail.svg")
        : name == "music" ? @image-url("../icons/app/music.svg")
        : name == "notes" ? @image-url("../icons/app/notes.svg")
        : name == "photos" ? @image-url("../icons/app/photos.svg")
        : name == "settings" ? @image-url("../icons/app/settings.svg")
        : name == "store" ? @image-url("../icons/app/store.svg")
        : name == "terminal" ? @image-url("../icons/app/terminal.svg")
        : name == "video" ? @image-url("../icons/app/video.svg")
        : name == "weather-clear" ? @image-url("../icons/app/weather-clear.svg")
        : name == "weather-cloudy" ? @image-url("../icons/app/weather-cloudy.svg")
        : name == "weather-night" ? @image-url("../icons/app/weather-night.svg")
        : name == "weather-partly" ? @image-url("../icons/app/weather-partly.svg")
        : name == "weather-rain" ? @image-url("../icons/app/weather-rain.svg")
        : @image-url("../icons/app/default.svg");
}

// A one-colour symbol, tinted with the colour it is given.
export component Symbol inherits Image {
    in property <string> name;
    in property <color> tint: Theme.text;
    colorize: tint;
    image-fit: contain;
    source: name == "" ? @image-url("../icons/symbols/more.svg")
        : name == "airplane" ? @image-url("../icons/symbols/airplane.svg")
        : name == "bell" ? @image-url("../icons/symbols/bell.svg")
        : name == "bell-off" ? @image-url("../icons/symbols/bell-off.svg")
