        : name == "headphones" ? @image-url("../icons/symbols/headphones.svg")
        : name == "help" ? @image-url("../icons/symbols/help.svg")
        : name == "info" ? @image-url("../icons/symbols/info.svg")
        : name == "keyboard" ? @image-url("../icons/symbols/keyboard.svg")
        : name == "keyboard-small" ? @image-url("../icons/symbols/keyboard-small.svg")
        : name == "lightning" ? @image-url("../icons/symbols/lightning.svg")
