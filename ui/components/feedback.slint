import { Theme } from "../tokens.slint";
import { Icon } from "../icons.slint";
import { Tone, ToneStyle } from "tone.slint";

/// A small label that appears over something on hover. Place it yourself; it only draws.
export component Tooltip inherits Rectangle {
    in property <string> text;
    preferred-width: label.preferred-width + 20px;
    height: 28px;
    border-radius: 8px;
    background: Theme.dark ? Theme.raised : #2A1226;
    border-width: 1px;
    border-color: Theme.line-strong;
    drop-shadow-blur: 12px; drop-shadow-offset-y: 4px; drop-shadow-color: Theme.shadow-tint.with-alpha(0.3);
    label := Text { text: root.text; color: Theme.dark ? Theme.ink : #F9F0F8; font-family: Theme.font-family; font-size: Theme.text-body-sm; font-weight: Theme.weight-ui; horizontal-alignment: center; vertical-alignment: center; }
}

/// A transient message with an optional action ("Undo").
export component Toast inherits Rectangle {
    in property <string> text;
    in property <string> icon: "check-circle";
    in property <Tone> tone: Tone.success;
    in property <string> action;
    callback action-clicked();
    callback dismissed();
    height: 48px;
    preferred-width: row.preferred-width;
    border-radius: 24px;
    background: Theme.raised;
    border-width: 1px;
    border-color: Theme.line-strong;
    drop-shadow-blur: 20px; drop-shadow-offset-y: 8px; drop-shadow-color: Theme.shadow-tint.with-alpha(Theme.shadow-2 + 0.08);
    row := HorizontalLayout {
        padding-left: 16px; padding-right: 8px; spacing: 10px;
        VerticalLayout { alignment: center; Icon { name: root.icon; tint: ToneStyle.fg(root.tone); size: 20px; } }
        Text { text: root.text; color: Theme.ink; font-family: Theme.font-family; font-size: Theme.text-body; font-weight: Theme.weight-ui; vertical-alignment: center; }
        if root.action != "": VerticalLayout {
            alignment: center;
            Rectangle {
                height: 32px; width: act.preferred-width + 20px; border-radius: 16px; background: a.has-hover ? Theme.accent-wash : transparent;
                act := Text { text: root.action; color: Theme.accent; font-family: Theme.font-family; font-size: Theme.text-body; font-weight: Theme.weight-ui; horizontal-alignment: center; vertical-alignment: center; }
                a := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.action-clicked(); } }
            }
        }
    }
}

/// A full-width notice inside a page, for something that needs attention without blocking.
export component Banner inherits Rectangle {
    in property <string> title;
    in property <string> text;
    in property <string> icon: "alert-triangle";
    in property <Tone> tone: Tone.warning;
    in property <bool> closable: true;
    callback closed();
    preferred-height: row.preferred-height;
    border-radius: Theme.radius-control;
    background: ToneStyle.wash(tone);
    border-width: 1px;
    border-color: ToneStyle.fg(tone).with-alpha(0.35);
    row := HorizontalLayout {
        padding: 14px; spacing: 12px;
        VerticalLayout { alignment: start; Icon { name: root.icon; tint: ToneStyle.fg(root.tone); size: 20px; } }
        VerticalLayout {
            spacing: 2px; horizontal-stretch: 1;
            Text { text: root.title; color: Theme.ink; font-family: Theme.font-family; font-size: Theme.text-body; font-weight: Theme.weight-ui; wrap: word-wrap; }
            if root.text != "": Text { text: root.text; color: Theme.muted; font-family: Theme.font-family; font-size: Theme.text-body-sm; wrap: word-wrap; }
        }
        if root.closable: VerticalLayout {
            alignment: start;
            Rectangle {
                width: 24px; height: 24px; border-radius: 8px; background: x.has-hover ? Theme.ink.with-alpha(0.10) : transparent;
                Icon { name: "close"; tint: Theme.muted; size: 14px; x: 5px; y: 5px; }
                x := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.closed(); } }
            }
        }
    }
}

/// A compact pill for filters and tags. `selected` fills it; `removable` adds an x.
export component Chip inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> selected: false;
    in property <bool> removable: false;
    callback clicked();
    callback removed();
    height: 32px;
    preferred-width: row.preferred-width;
    border-radius: 16px;
    background: selected ? Theme.accent-soft : area.has-hover ? Theme.accent-wash : transparent;
    border-width: 1px;
    border-color: selected ? Theme.accent : Theme.line-strong;
    animate background { duration: Theme.dur-feedback; }
    row := HorizontalLayout {
        padding-left: 12px; padding-right: removable ? 6px : 12px; spacing: 6px;
        if root.icon != "": VerticalLayout { alignment: center; Icon { name: root.icon; tint: root.selected ? Theme.accent : Theme.muted; size: 16px; } }
        Text { text: root.text; color: root.selected ? Theme.accent : Theme.ink; font-family: Theme.font-family; font-size: Theme.text-body-sm; font-weight: Theme.weight-ui; vertical-alignment: center; }
        if root.removable: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 20px; height: 20px; border-radius: 10px; background: rm.has-hover ? Theme.ink.with-alpha(0.12) : transparent;
                Icon { name: "close"; tint: Theme.muted; size: 12px; x: 4px; y: 4px; }
                rm := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.removed(); } }
            }
        }
    }
    area := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.clicked(); } }
}

/// A person or thing: a photo, or initials on an accent tint, with an optional presence dot.
export component Avatar inherits Rectangle {
    in property <string> initials;
    in property <image> source;
    in property <length> size: 40px;
    in property <bool> online: false;
    width: size; height: size;
    border-radius: size / 2;
    background: Theme.accent-soft;
    clip: true;
    Text { visible: root.source.width == 0; text: root.initials; color: Theme.accent; font-family: Theme.font-family; font-size: root.size * 0.38; font-weight: Theme.weight-title; horizontal-alignment: center; vertical-alignment: center; }
    Image { visible: root.source.width > 0; source: root.source; width: parent.width; height: parent.height; image-fit: ImageFit.cover; }
}

/// Progress through a wizard: numbered dots joined by a line; done steps show a check.
export component Stepper inherits Rectangle {
    in property <[string]> steps;
    in property <int> current: 0;
    height: 56px;
    min-width: 120px * steps.length;
    for step[i] in steps: Rectangle {
        x: i * (root.width / max(1, root.steps.length));
        width: root.width / max(1, root.steps.length);
        if i > 0: Rectangle { x: 0px; y: 14px; width: parent.width / 2 - 14px; height: 2px; background: i <= root.current ? Theme.accent : Theme.track; }
        if i < root.steps.length - 1: Rectangle { x: parent.width / 2 + 14px; y: 14px; width: parent.width / 2 - 14px; height: 2px; background: i < root.current ? Theme.accent : Theme.track; }
        Rectangle {
            x: (parent.width - 30px) / 2; y: 0px; width: 30px; height: 30px; border-radius: 15px;
            background: i <= root.current ? Theme.accent : Theme.track;
            Icon { visible: i < root.current; name: "check"; tint: Theme.on-accent; size: 16px; x: 7px; y: 7px; }
            Text { visible: i >= root.current; text: i + 1; color: i == root.current ? Theme.on-accent : Theme.muted; font-family: Theme.font-family; font-size: Theme.text-body-sm; font-weight: Theme.weight-ui; horizontal-alignment: center; vertical-alignment: center; }
        }
        Text { y: 36px; text: step; color: i == root.current ? Theme.ink : Theme.muted; font-family: Theme.font-family; font-size: Theme.text-caption; font-weight: Theme.weight-ui; horizontal-alignment: center; }
    }
}
