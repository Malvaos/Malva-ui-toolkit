import { Theme } from "../tokens.slint";

/// The Malva focus indicator: a 2 px accent ring with a 2 px surface halo inside it, so it reads on
/// any background. Put it as the LAST child of the control and give it the control's size.
/// Controls show it for keyboard focus only (see `kb` in each control).
export component FocusRing inherits Rectangle {
    in property <bool> active: false;
    in property <length> corner: Theme.radius-control;
    background: transparent;
    visible: active;
    Rectangle {
        x: -2px; y: -2px;
        width: parent.width + 4px; height: parent.height + 4px;
        border-radius: root.corner + 2px;
        border-width: Theme.ring-width;
        border-color: Theme.bg;
    }
    Rectangle {
        x: -4px; y: -4px;
        width: parent.width + 8px; height: parent.height + 8px;
        border-radius: root.corner + 4px;
        border-width: Theme.ring-width;
        border-color: Theme.ring;
    }
}
