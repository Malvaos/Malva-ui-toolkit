import { Theme } from "../tokens.slint";
import { Icon } from "../icons.slint";

/// A list row: icon, title with an optional second line, a trailing value and an optional chevron.
export component ListRow inherits Rectangle {
    in property <string> icon;
    in property <string> title;
    in property <string> subtitle;
    in property <string> trailing;
    in property <bool> chevron: false;
    in property <bool> selected: false;
    in property <bool> enabled: true;
    in property <color> icon-tint: Theme.accent;
    callback clicked();
    height: subtitle != "" ? 56px : 48px;
    border-radius: Theme.radius-control;
    background: selected ? Theme.accent-soft : area.pressed ? Theme.accent-soft : area.has-hover ? Theme.accent-wash : transparent;
    opacity: enabled ? 1.0 : Theme.alpha-disabled;
    animate background { duration: Theme.dur-feedback; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    HorizontalLayout {
        padding-left: 12px; padding-right: 12px; spacing: 12px;
        if root.icon != "": VerticalLayout {
            alignment: center;
            Rectangle {
                width: 32px; height: 32px; border-radius: 9px; background: root.icon-tint.with-alpha(0.16);
                Icon { name: root.icon; tint: root.icon-tint; size: 18px; x: 7px; y: 7px; }
            }
        }
        VerticalLayout {
            alignment: center; horizontal-stretch: 1;
            Text { text: root.title; color: Theme.ink; font-family: Theme.font-family; font-size: Theme.text-body; font-weight: Theme.weight-ui; overflow: elide; }
            if root.subtitle != "": Text { text: root.subtitle; color: Theme.muted; font-family: Theme.font-family; font-size: Theme.text-body-sm; overflow: elide; }
        }
        if root.trailing != "": Text { text: root.trailing; color: Theme.muted; font-family: Theme.font-family; font-size: Theme.text-body-sm; vertical-alignment: center; }
        if root.chevron: VerticalLayout { alignment: center; Icon { name: "chevron-right"; tint: Theme.muted; size: 16px; } }
    }
    area := TouchArea { enabled: root.enabled; mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default; clicked => { root.clicked(); } }
}
