import { Theme } from "../tokens.slint";
import { Icon } from "../icons.slint";
import { FocusRing } from "focus-ring.slint";

export enum ButtonVariant { primary, secondary, ghost, danger }
export enum ControlSize { sm, md, lg }

/// A push button. States: default / hover / pressed (scales to 0.96) / focus (keyboard ring) / disabled (40 %).
export component Button inherits Rectangle {
    in property <string> text;
    /// Name of an icon from `Icons` shown before the text.
    in property <string> icon;
    in property <ButtonVariant> variant: ButtonVariant.primary;
    in property <ControlSize> size: ControlSize.md;
    in property <bool> enabled: true;
    /// Documentation/testing aid: "hover", "pressed" or "focus" draws that state without a pointer.
    in property <string> preview-state;
    callback clicked();
    out property <bool> pressed: ta.pressed || preview-state == "pressed";
    out property <bool> hovered: ta.has-hover || preview-state == "hover";
    out property <bool> has-focus: fs.has-focus;

    private property <bool> kb: false;
    private property <color> label: variant == ButtonVariant.primary ? Theme.on-accent
        : variant == ButtonVariant.danger ? Theme.on-danger
        : variant == ButtonVariant.ghost ? Theme.accent : Theme.ink;
    private property <color> fill: variant == ButtonVariant.primary ? (pressed ? Theme.accent-pressed : hovered ? Theme.accent-hover : Theme.accent)
        : variant == ButtonVariant.danger ? (pressed ? Theme.danger-pressed : hovered ? Theme.danger-hover : Theme.danger)
        : variant == ButtonVariant.ghost ? (pressed ? Theme.accent-soft : hovered ? Theme.accent-wash : transparent)
        : (pressed ? Theme.track : hovered ? Theme.raised : Theme.surface);

    height: size == ControlSize.sm ? Theme.control-height-sm : size == ControlSize.lg ? Theme.control-height-lg : Theme.control-height;
    min-width: self.height;
    preferred-width: content.preferred-width;
    border-radius: Theme.radius-control;
    background: fill;
    border-width: variant == ButtonVariant.secondary ? 1px : 0px;
    border-color: Theme.line-strong;
    opacity: enabled ? 1.0 : Theme.alpha-disabled;
    transform-scale: (pressed && enabled) ? Theme.press-scale : 1.0;
    animate background { duration: Theme.dur-feedback; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    animate transform-scale { duration: Theme.dur-feedback; easing: cubic-bezier(0.34, 1.35, 0.64, 1); }

    content := HorizontalLayout {
        padding-left: size == ControlSize.sm ? 12px : 20px;
        padding-right: size == ControlSize.sm ? 12px : 20px;
        spacing: 8px;
        alignment: center;
        if root.icon != "": VerticalLayout {
            alignment: center;
            Icon { name: root.icon; tint: root.label; size: root.size == ControlSize.sm ? 16px : 18px; }
        }
        if root.text != "": Text {
            text: root.text;
            color: root.label;
            font-family: Theme.font-family;
            font-size: root.size == ControlSize.lg ? Theme.text-subtitle : root.size == ControlSize.sm ? Theme.text-body-sm : Theme.text-body;
            font-weight: Theme.weight-ui;
            vertical-alignment: center;
        }
    }

    fs := FocusScope {
        enabled: root.enabled;
        key-pressed(e) => {
            if (e.text == " " || e.text == Key.Return) { root.kb = true; root.clicked(); return accept; }
            return reject;
        }
        focus-gained(reason) => { root.kb = reason == FocusReason.tab-navigation; }
        ta := TouchArea {
            enabled: root.enabled;
            mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
            pointer-event(e) => { if (e.kind == PointerEventKind.down) { root.kb = false; } }
            clicked => { fs.focus(); root.clicked(); }
        }
    }
    FocusRing { active: (fs.has-focus && root.kb) || root.preview-state == "focus"; corner: root.border-radius; width: parent.width; height: parent.height; }
}
