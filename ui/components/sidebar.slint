import { Theme } from "../tokens.slint";
import { Icon } from "../icons.slint";

/// One destination in a Sidebar. `count` shows a small number on the right when it is above 0.
export component SidebarItem inherits Rectangle {
    in property <string> icon;
    in property <string> text;
    in property <bool> active: false;
    in property <int> count: 0;
    callback clicked();
    height: 36px;
    border-radius: Theme.radius-control;
    background: active ? Theme.accent : area.pressed ? Theme.accent-soft : area.has-hover ? Theme.accent-wash : transparent;
    animate background { duration: Theme.dur-feedback; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    accessible-role: tab;
    accessible-label: text;
    HorizontalLayout {
        padding-left: 12px; padding-right: 12px; spacing: 10px;
        if root.icon != "": VerticalLayout { alignment: center; Icon { name: root.icon; tint: root.active ? Theme.on-accent : Theme.muted; size: 18px; } }
        Text { text: root.text; color: root.active ? Theme.on-accent : Theme.ink; font-family: Theme.font-family; font-size: Theme.text-body; font-weight: Theme.weight-ui; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
        if root.count > 0: VerticalLayout {
            alignment: center;
            Rectangle {
                height: 18px; min-width: 18px; border-radius: 9px;
                background: root.active ? Theme.on-accent.with-alpha(0.22) : Theme.accent-soft;
                Text { text: root.count; color: root.active ? Theme.on-accent : Theme.accent; font-family: Theme.font-family; font-size: 11px; font-weight: Theme.weight-ui; horizontal-alignment: center; vertical-alignment: center; }
            }
        }
    }
    area := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.clicked(); } }
}

/// A small caption that groups sidebar items.
export component SidebarHeading inherits Rectangle {
    in property <string> text;
    height: 28px;
    Text { x: 12px; text: root.text; color: Theme.muted; font-family: Theme.font-family; font-size: Theme.text-caption; font-weight: Theme.weight-ui; vertical-alignment: bottom; }
}

/// The navigation column of a window: a slightly raised surface with a hairline on its right edge.
export component Sidebar inherits Rectangle {
    in property <length> content-width: 240px;
    width: content-width;
    background: Theme.dark ? Theme.surface : Theme.bg.mix(Theme.surface, 0.5);
    Rectangle { x: parent.width - 1px; width: 1px; background: Theme.line; }
    VerticalLayout { padding: 12px; spacing: 2px; alignment: start; @children }
}
