// The design sheets: every component of the kit in every state, drawn by the kit's own components.
// windows.slint (generated by tools/gen_gallery.py) wraps each sheet in a light and a dark window.
import {
    Theme, Space, Size, Radius, Typo, Palette, Icon, Logo, AppIcon, ControlSize, ForceState, Tone,
    Title, Heading, Body, BodyStrong, Label, Caption, Code, Divider,
    Button, ButtonKind, IconButton, ButtonGroup, Toggle, Checkbox, Radio, RadioGroup, RadioRow, Slider,
    ProgressBar, Spinner, ProgressRing, TextField, SearchField, TextArea, Stepper, Dropdown, OptionList,
    SegmentedControl, Tabs, SidebarItem, Breadcrumbs, Card, Panel, GlassPanel, Avatar, Chip, ListItem, Picture, PictureShape, QuickTile,
    Badge, Banner, Toast, Skeleton, Tooltip, MenuEntry, MenuPanel, DialogCard, ScrollArea, TitleBar, WindowFrame, Sidebar, SidebarSection,
} from "../slint/malva.slint";

// The page every sheet sits on.
component Page inherits Rectangle {
    in property <string> title;
    in property <string> note;
    background: Theme.bg;
    VerticalLayout {
        padding: 36px;
        padding-top: 32px;
        spacing: 26px;
        alignment: start;
        VerticalLayout {
            spacing: 4px;
            Title { text: root.title; }
            Caption { text: root.note; }
        }
        @children
    }
}

// A labelled group on a sheet.
component Section inherits Rectangle {
    in property <string> title;
    VerticalLayout {
        spacing: 12px;
        alignment: start;
        BodyStrong { text: root.title; }
        @children
    }
}

component Legend inherits Text {
    font-family: Typo.ui;
    font-size: Typo.caption-size;
    color: Theme.muted;
}

// ------------------------------------------------------------------ Overview (the brand's component board)
export component Overview inherits Page {
    title: "Malva OS — Components";
    note: "Every part of the kit on one board.";
    width: 1360px;
    height: 720px;
    HorizontalLayout {
        spacing: 48px;
        alignment: start;
        VerticalLayout {
            spacing: 26px;
            alignment: start;
            width: 330px;
            Section {
                title: "Buttons";
                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;
                    Button { text: "Save changes"; kind: ButtonKind.primary; }
                    Button { text: "Cancel"; }
                    Button { text: "Skip"; kind: ButtonKind.ghost; }
                }
                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;
                    Button { text: "Delete"; kind: ButtonKind.danger; }
                    Button { text: "Disabled"; enabled: false; }
                }
            }
            Section {
                title: "Toggles, checks, radios";
                HorizontalLayout {
                    spacing: 14px;
                    alignment: start;
                    Toggle { checked: true; }
                    Toggle { }
                    Checkbox { checked: true; }
                    Checkbox { }
                    Radio { selected: true; }
                    Radio { }
                }
            }
            Section {
                title: "Slider & progress";
                VerticalLayout {
                    spacing: 18px;
                    HorizontalLayout {
                        spacing: 24px;
                        Slider { value: 55; width: 230px; }
                        Spinner { }
                    }
                    ProgressBar { value: 0.55; }
                }
            }
            Section {
                title: "Inputs";
                VerticalLayout {
                    spacing: 12px;
                    TextField { placeholder: "Device name"; }
                    TextField { text: "Studio laptop"; force: ForceState.focus; }
                    TextField { text: "Name already used"; error: "Name already used"; }
                }
            }
        }
        VerticalLayout {
            spacing: 26px;
            alignment: start;
            width: 300px;
            Section {
                title: "Search field";
                SearchField { placeholder: "Search apps and files"; }
            }
            Section {
                title: "Segmented control & tabs";
                VerticalLayout {
                    spacing: 18px;
                    SegmentedControl { model: ["Day", "Week", "Month"]; }
                    Tabs { model: ["General", "Network", "Privacy"]; }
                }
            }
            Section {
                title: "Badges & tooltip";
                VerticalLayout {
                    spacing: 10px;
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        Badge { text: "Synced"; tone: Tone.success; }
                        Badge { text: "Low battery"; tone: Tone.warning; }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        Badge { text: "Offline"; tone: Tone.danger; }
                        Badge { text: "New"; tone: Tone.accent; }
                        Tooltip { text: "Copy link"; }
                    }
                }
            }
            Section {
                title: "Dropdown";
                Dropdown { model: ["Day", "Week", "Month"]; current-index: 1; }
            }
        }
        VerticalLayout {
            spacing: 26px;
            alignment: start;
            width: 520px;
            HorizontalLayout {
                spacing: 36px;
                alignment: start;
                Section {
                    title: "Context menu";
                    MenuPanel {
                        highlighted: 0;
                        entries: [
                            { text: "Open", shortcut: "Enter", icon: "", danger: false, disabled: false, separator: false, checked: false },
                            { text: "Rename", shortcut: "F2", icon: "", danger: false, disabled: false, separator: false, checked: false },
                            { text: "Duplicate", shortcut: "Ctrl D", icon: "", danger: false, disabled: false, separator: false, checked: false },
                            { text: "", shortcut: "", icon: "", danger: false, disabled: false, separator: true, checked: false },
                            { text: "Move to Trash", shortcut: "Del", icon: "", danger: true, disabled: false, separator: false, checked: false },
                            { text: "Share…", shortcut: "", icon: "", danger: false, disabled: false, separator: false, checked: false },
                        ];
                    }
                }
                Section {
                    title: "Quick settings tile";
                    HorizontalLayout {
                        spacing: 8px;
                        QuickTile { icon: "wifi"; text: "Wi-Fi"; on: true; }
                        QuickTile { icon: "bluetooth"; text: "Bluetooth"; }
                    }
                }
            }
            Section {
                title: "Dialog";
                DialogCard {
                    title: "Empty the Trash?";
                    message: "42 items will be deleted permanently.";
                    tone: Tone.danger;
                    primary-text: "Empty Trash";
                }
            }
            Section {
                title: "Notification toast";
                Toast { title: "Backup finished"; text: "2,184 files saved to Studio Drive"; settled: true; life: 0ms; }
            }
        }
    }
}

// ------------------------------------------------------------------ Buttons
component StateCell inherits Rectangle {
    in property <string> text;
    width: 124px;
    height: 56px;
    @children
}

export component Buttons inherits Page {
    title: "Button";
    note: "Primary, secondary, ghost and danger, in every state. 40 px high, 10 px corners, hover 160 ms, press 90 ms.";
    width: 940px;
    height: 780px;
    VerticalLayout {
        spacing: 14px;
        alignment: start;
        for kind[k] in [ButtonKind.primary, ButtonKind.secondary, ButtonKind.ghost, ButtonKind.danger]: HorizontalLayout {
            spacing: 14px;
            alignment: start;
            height: 56px;
            for st[i] in [ForceState.none, ForceState.hover, ForceState.pressed, ForceState.focus]: StateCell {
                Button {
                    x: 6px;
                    y: 8px;
                    width: 112px;
                    text: kind == ButtonKind.primary ? "Primary" : kind == ButtonKind.secondary ? "Secondary" : kind == ButtonKind.ghost ? "Ghost" : "Delete";
                    kind: kind;
                    force: st;
                }
            }
            StateCell {
                Button {
                    x: 6px;
                    y: 8px;
                    width: 112px;
                    text: kind == ButtonKind.primary ? "Primary" : kind == ButtonKind.secondary ? "Secondary" : kind == ButtonKind.ghost ? "Ghost" : "Delete";
                    kind: kind;
                    enabled: false;
                }
            }
        }
        HorizontalLayout {
            spacing: 14px;
            alignment: start;
            for l in ["default", "hover", "pressed", "focus", "disabled"]: Legend {
                text: l;
                width: 124px;
                horizontal-alignment: center;
            }
        }
    }
    Section {
        title: "Sizes, icons, loading";
        VerticalLayout {
            spacing: 14px;
            HorizontalLayout {
                spacing: 14px;
                alignment: start;
                Button { text: "Small"; size: ControlSize.small; kind: ButtonKind.primary; }
                Button { text: "Medium"; kind: ButtonKind.primary; }
                Button { text: "Large"; size: ControlSize.large; kind: ButtonKind.primary; }
                Button { text: "New folder"; icon: "plus"; kind: ButtonKind.primary; }
                Button { text: "Share"; icon: "share"; trailing-icon: "chevron-down"; }
                Button { text: "Saving"; loading: true; kind: ButtonKind.primary; }
            }
        }
    }
    Section {
        title: "Icon button";
        HorizontalLayout {
            spacing: 14px;
            alignment: start;
            IconButton { icon: "star"; }
            IconButton { icon: "star"; force: ForceState.hover; }
            IconButton { icon: "star"; force: ForceState.pressed; }
            IconButton { icon: "star"; force: ForceState.focus; }
            IconButton { icon: "star"; enabled: false; }
            IconButton { icon: "grid"; selected: true; }
            IconButton { icon: "plus"; accent: true; }
            IconButton { icon: "search"; size: ControlSize.small; }
            IconButton { icon: "gear"; size: ControlSize.large; }
        }
    }
    Section {
        title: "Button group";
        ButtonGroup {
            width: 360px;
            Button { text: "Cancel"; }
            Button { text: "Save changes"; kind: ButtonKind.primary; }
        }
    }
}

// ------------------------------------------------------------------ Controls
export component Controls inherits Page {
    title: "Toggle, checkbox, radio, slider, progress";
    note: "Springs on open and close, 240 ms; the knob stretches while pressed.";
    width: 940px;
    height: 650px;
    Section {
        title: "Toggle";
        HorizontalLayout {
            spacing: 22px;
            alignment: start;
            Toggle { }
            Toggle { checked: true; }
            Toggle { checked: true; force: ForceState.focus; }
            Toggle { checked: true; enabled: false; }
            Toggle { enabled: false; }
            Toggle { checked: true; text: "With a label"; }
        }
    }
    Section {
        title: "Checkbox";
        HorizontalLayout {
            spacing: 22px;
            alignment: start;
            Checkbox { }
            Checkbox { checked: true; }
            Checkbox { checked: true; force: ForceState.focus; }
            Checkbox { enabled: false; }
            Checkbox { indeterminate: true; }
            Checkbox { checked: true; text: "Keep me signed in"; }
        }
    }
    Section {
        title: "Radio";
        HorizontalLayout {
            spacing: 22px;
            alignment: start;
            Radio { }
            Radio { selected: true; }
            Radio { selected: true; force: ForceState.focus; }
            Radio { enabled: false; }
            RadioRow { model: ["Light", "Dark", "Auto"]; current-index: 2; }
        }
    }
    Section {
        title: "Slider";
        VerticalLayout {
            spacing: 18px;
            HorizontalLayout {
                spacing: 36px;
                Slider { value: 0; width: 240px; }
                Slider { value: 50; width: 240px; force: ForceState.hover; }
                Slider { value: 100; width: 240px; force: ForceState.focus; }
            }
            HorizontalLayout {
                spacing: 36px;
                Slider { value: 40; width: 240px; enabled: false; }
                Slider { value: 70; width: 240px; show-value: true; force: ForceState.pressed; }
            }
        }
    }
    Section {
        title: "Progress";
        VerticalLayout {
            spacing: 18px;
            HorizontalLayout {
                spacing: 36px;
                ProgressBar { value: 0.0; width: 240px; }
                ProgressBar { value: 0.55; width: 240px; }
                ProgressBar { value: 1.0; width: 240px; }
            }
            HorizontalLayout {
                spacing: 36px;
                alignment: start;
                Spinner { }
                Spinner { width: 32px; height: 32px; thickness: 4px; }
                ProgressRing {
                    value: 0.72;
                    width: 72px;
                    height: 72px;
                    Text { text: "72%"; font-family: Typo.ui; font-size: 15px; font-weight: 600; color: Theme.text; horizontal-alignment: center; vertical-alignment: center; }
                }
                ProgressRing { value: 0.3; width: 72px; height: 72px; tone: Theme.danger; thickness: 6px; }
            }
        }
    }
}

// ------------------------------------------------------------------ Inputs
export component Inputs inherits Page {
    title: "Text field, search, dropdown, stepper";
    note: "42 px fields, 10 px corners, a 2 px accent ring on focus and a red one on error.";
    width: 1060px;
    height: 780px;
    HorizontalLayout {
        spacing: 36px;
        VerticalLayout {
            spacing: 16px;
            alignment: start;
            width: 300px;
            TextField { label: "Default"; placeholder: "Device name"; }
            TextField { label: "Hover"; placeholder: "Device name"; force: ForceState.hover; }
            TextField { label: "Focus"; text: "Studio laptop"; force: ForceState.focus; }
            TextField { label: "Error"; text: "Studio laptop"; error: "Name already used"; }
            TextField { label: "Disabled"; text: "Studio laptop"; enabled: false; }
        }
        VerticalLayout {
            spacing: 16px;
            alignment: start;
            width: 300px;
            TextField { label: "With icon"; icon: "user"; placeholder: "Username"; }
            TextField { label: "Password"; password: true; text: "hunter2hunter2"; }
            TextField { label: "Clearable"; clearable: true; text: "Search term"; helper: "Press Enter to run it"; }
            SearchField { placeholder: "Search apps and files"; }
            SearchField { text: "Notes"; force: ForceState.focus; }
        }
        VerticalLayout {
            spacing: 16px;
            alignment: start;
            width: 280px;
            Dropdown { label: "Dropdown"; model: ["Day", "Week", "Month"]; current-index: 1; }
            Dropdown { label: "Empty"; model: ["Day", "Week", "Month"]; placeholder: "Choose a range"; }
            Section {
                title: "Open list";
                OptionList { model: ["Day", "Week", "Month", "Year"]; current-index: 1; highlighted: 2; width: 240px; }
            }
            Section {
                title: "Stepper";
                Stepper { value: 3; }
            }
        }
    }
    TextArea { width: 460px; height: 100px; placeholder: "Notes about this device"; text: "Bought in March. The left hinge squeaks a little when the lid opens past ninety degrees."; }
}

// ------------------------------------------------------------------ Navigation
export component Navigation inherits Page {
    title: "Segmented control, tabs, sidebar, breadcrumbs";
    note: "The segmented thumb springs; tabs underline the current one.";
    width: 940px;
    height: 640px;
    HorizontalLayout {
        spacing: 48px;
        VerticalLayout {
            spacing: 26px;
            alignment: start;
            width: 380px;
            Section {
                title: "Segmented control";
                VerticalLayout {
                    spacing: 12px;
                    SegmentedControl { model: ["Day", "Week", "Month"]; }
                    SegmentedControl { model: ["List", "Grid"]; current-index: 1; }
                    SegmentedControl { model: ["One", "Two", "Three", "Four"]; current-index: 2; enabled: false; }
                }
            }
            Section {
                title: "Tabs";
                Tabs { model: ["General", "Network", "Privacy", "Advanced"]; current-index: 1; }
            }
            Section {
                title: "Breadcrumbs";
                Breadcrumbs { model: ["Home", "Documents", "Reports", "2026"]; }
            }
        }
        Section {
            title: "Sidebar";
            Rectangle {
                width: 220px;
                height: 330px;
                border-radius: Radius.l;
                background: Theme.bg;
                border-width: 1px;
                border-color: Theme.border;
                VerticalLayout {
                    padding: 8px;
                    spacing: 2px;
                    alignment: start;
                    SidebarSection { text: "FAVOURITES"; }
                    SidebarItem { text: "Recent"; icon: "clock"; selected: true; }
                    SidebarItem { text: "Documents"; icon: "file-text"; count: 12; }
                    SidebarItem { text: "Pictures"; icon: "image"; force: ForceState.hover; }
                    SidebarItem { text: "Downloads"; icon: "download"; force: ForceState.focus; }
                    SidebarSection { text: "DEVICES"; }
                    SidebarItem { text: "Studio Drive"; icon: "drive"; }
                    SidebarItem { text: "Trash"; icon: "trash"; }
                }
            }
        }
    }
}

// ------------------------------------------------------------------ Feedback
export component Feedback inherits Page {
    title: "Badge, banner, toast, tooltip, dialog";
    note: "Tones: accent, success, warning, danger, info. Soft fills with readable text; contrast is checked in the tests.";
    width: 1280px;
    height: 800px;
    HorizontalLayout {
        spacing: 40px;
        VerticalLayout {
            spacing: 24px;
            alignment: start;
            width: 520px;
            Section {
                title: "Badge";
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Badge { text: "Neutral"; }
                    Badge { text: "New"; tone: Tone.accent; }
                    Badge { text: "Synced"; tone: Tone.success; icon: "check"; }
                    Badge { text: "Low battery"; tone: Tone.warning; }
                    Badge { text: "Offline"; tone: Tone.danger; }
                    Badge { text: "Beta"; tone: Tone.info; }
                }
            }
            Section {
                title: "Banner";
                VerticalLayout {
                    spacing: 10px;
                    Banner { tone: Tone.info; title: "Update available"; text: "Malva 1.1 improves sleep and wake."; action: "Install"; closable: true; }
                    Banner { tone: Tone.success; title: "All set"; text: "Your files are backed up."; }
                    Banner { tone: Tone.warning; title: "Low battery"; text: "12% left. Plug in soon."; action: "Power settings"; }
                    Banner { tone: Tone.danger; title: "Disk almost full"; text: "Free some space to keep working."; closable: true; }
                }
            }
            Section {
                title: "Tooltip";
                HorizontalLayout {
                    spacing: 24px;
                    alignment: start;
                    Tooltip { text: "Copy link"; }
                    Rectangle {
                        width: 130px;
                        height: 60px;
                        Tooltip { y: 6px; text: "Below the control"; below: true; }
                    }
                }
            }
            Section {
                title: "Skeleton";
                VerticalLayout {
                    spacing: 8px;
                    Skeleton { width: 360px; }
                    Skeleton { width: 280px; }
                    Skeleton { width: 320px; height: 64px; corner: Radius.m; }
                }
            }
        }
        VerticalLayout {
            spacing: 24px;
            alignment: start;
            Section {
                title: "Toast";
                VerticalLayout {
                    spacing: 10px;
                    Toast { title: "Backup finished"; text: "2,184 files saved to Studio Drive"; settled: true; life: 0ms; }
                    Toast { tone: Tone.info; title: "Update ready"; text: "Restart to finish installing."; action: "Restart"; settled: true; life: 0ms; }
                    Toast { tone: Tone.warning; title: "Battery low"; text: "12% remaining"; settled: true; life: 0ms; }
                    Toast { tone: Tone.danger; title: "Couldn't connect"; text: "Check your network and try again."; settled: true; life: 0ms; }
                }
            }
            Section {
                title: "Dialog";
                HorizontalLayout {
                    spacing: 24px;
                    alignment: start;
                    DialogCard { title: "Empty the Trash?"; message: "42 items will be deleted permanently."; tone: Tone.danger; primary-text: "Empty Trash"; }
                    DialogCard { title: "Restart now?"; message: "Open windows will be saved."; tone: Tone.accent; icon: "restart"; primary-text: "Restart"; width: 340px; }
                }
            }
        }
    }
}

// ------------------------------------------------------------------ Surfaces
export component Surfaces inherits Page {
    title: "Card, list, avatar, chip, tile, picture";
    note: "Cards come in four elevations; three layers of surface: bg, panel, surface.";
    width: 1180px;
    height: 920px;
    VerticalLayout {
        spacing: 26px;
        alignment: start;
        Section {
            title: "Card — level 0, 1, 2, 3, and interactive";
            HorizontalLayout {
                spacing: 24px;
                alignment: start;
                for lv in [0, 1, 2, 3]: Card {
                    level: lv;
                    width: 150px;
                    height: 96px;
                    Text { text: "Level " + lv; font-family: Typo.ui; font-size: Typo.body-size; color: Theme.text-2; horizontal-alignment: center; vertical-alignment: center; }
                }
                Card {
                    level: 1;
                    interactive: true;
                    force: ForceState.hover;
                    width: 150px;
                    height: 96px;
                    Text { text: "Interactive"; font-family: Typo.ui; font-size: Typo.body-size; color: Theme.text-2; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
        }
        HorizontalLayout {
            spacing: 40px;
            VerticalLayout {
                spacing: 26px;
                alignment: start;
                width: 400px;
                Section {
                    title: "List";
                    Card {
                        level: 1;
                        height: 4 * 56px + 16px;
                        VerticalLayout {
                            padding: 8px;
                            spacing: 0px;
                            alignment: start;
                            ListItem { title: "Notes.md"; subtitle: "Edited today"; icon: "file-text"; trailing: "12 KB"; chevron: true; }
                            ListItem { title: "Plan.pdf"; subtitle: "Edited yesterday"; icon: "file"; selected: true; trailing: "1.4 MB"; }
                            ListItem { title: "Holiday photos"; subtitle: "212 items"; icon: "image"; force: ForceState.hover; chevron: true; }
                            ListItem { title: "Archive.zip"; subtitle: "Locked"; icon: "archive"; enabled: false; }
                        }
                    }
                }
                Section {
                    title: "Avatar";
                    HorizontalLayout {
                        spacing: 12px;
                        alignment: start;
                        Avatar { initials: "AB"; presence: "online"; }
                        Avatar { initials: "CD"; presence: "busy"; tone: Theme.info; }
                        Avatar { initials: "EF"; presence: "away"; tone: Theme.success; }
                        Avatar { initials: "GH"; square: true; }
                        Avatar { initials: "IJ"; width: 56px; height: 56px; }
                    }
                }
            }
            VerticalLayout {
                spacing: 26px;
                alignment: start;
                Section {
                    title: "Chip";
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        Chip { text: "All"; selected: true; }
                        Chip { text: "Documents"; icon: "file-text"; }
                        Chip { text: "Images"; icon: "image"; }
                        Chip { text: "work"; removable: true; }
                        Chip { text: "Disabled"; enabled: false; }
                    }
                }
                Section {
                    title: "Quick tiles";
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        QuickTile { icon: "wifi"; text: "Wi-Fi"; on: true; }
                        QuickTile { icon: "bluetooth"; text: "Bluetooth"; }
                        QuickTile { icon: "moon"; text: "Night"; on: true; }
                        QuickTile { icon: "airplane"; text: "Airplane"; force: ForceState.hover; }
                        QuickTile { icon: "sun"; text: "Light"; enabled: false; }
                    }
                }
                Section {
                    title: "Picture shapes";
                    HorizontalLayout {
                        spacing: 14px;
                        alignment: start;
                        Picture { width: 84px; height: 84px; shape: PictureShape.rounded; source: @image-url("../svg/logo/malva-bloom.svg"); }
                        Picture { width: 84px; height: 84px; shape: PictureShape.squircle; source: @image-url("../svg/logo/malva-bloom.svg"); }
                        Picture { width: 84px; height: 84px; shape: PictureShape.circle; source: @image-url("../svg/logo/malva-bloom.svg"); }
                        Picture { width: 84px; height: 84px; shape: PictureShape.square; source: @image-url("../svg/logo/malva-bloom.svg"); }
                    }
                }
                Section {
                    title: "Layers and glass";
                    HorizontalLayout {
                        spacing: 12px;
                        alignment: start;
                        Rectangle { width: 90px; height: 60px; background: Theme.bg; border-radius: Radius.m; border-width: 1px; border-color: Theme.border; Caption { text: "bg"; horizontal-alignment: center; vertical-alignment: center; } }
                        Rectangle { width: 90px; height: 60px; background: Theme.panel; border-radius: Radius.m; Caption { text: "panel"; horizontal-alignment: center; vertical-alignment: center; } }
                        Rectangle { width: 90px; height: 60px; background: Theme.surface; border-radius: Radius.m; border-width: 1px; border-color: Theme.border; Caption { text: "surface"; horizontal-alignment: center; vertical-alignment: center; } }
                        Rectangle { width: 90px; height: 60px; background: Theme.raised; border-radius: Radius.m; border-width: 1px; border-color: Theme.border; Caption { text: "raised"; horizontal-alignment: center; vertical-alignment: center; } }
                        Rectangle {
                            width: 150px;
                            height: 60px;
                            border-radius: Radius.m;
                            background: @linear-gradient(135deg, Palette.plum, Palette.orchid, Palette.lilac);
                            GlassPanel { x: 12px; y: 12px; width: 126px; height: 36px; border-radius: Radius.s; Caption { text: "glass"; color: Theme.text; horizontal-alignment: center; vertical-alignment: center; } }
                        }
                    }
                }
            }
        }
        Section {
            title: "Scroll area";
            Card {
                level: 0;
                width: 400px;
                height: 120px;
                ScrollArea {
                    always-visible: true;
                    VerticalLayout {
                        padding: 12px;
                        spacing: 8px;
                        for i in 8: Skeleton { height: 14px; width: 260px + mod(i * 53, 90) * 1px; }
                    }
                }
            }
        }
    }
}

// ------------------------------------------------------------------ Window
export component WindowChrome inherits Page {
    title: "Window chrome";
    note: "A 44 px title bar with the three controls, a sidebar, a content area.";
    width: 900px;
    height: 600px;
    WindowFrame {
        title: "Files";
        width: 780px;
        height: 400px;
        HorizontalLayout {
            Sidebar {
                SidebarSection { text: "PLACES"; }
                SidebarItem { text: "Recent"; icon: "clock"; selected: true; }
                SidebarItem { text: "Documents"; icon: "file-text"; }
                SidebarItem { text: "Pictures"; icon: "image"; }
                SidebarItem { text: "Downloads"; icon: "download"; }
            }
            Rectangle {
                background: Theme.surface;
                VerticalLayout {
                    padding: 24px;
                    spacing: 16px;
                    alignment: start;
                    Breadcrumbs { model: ["Home", "Recent"]; }
                    HorizontalLayout {
                        spacing: 16px;
                        alignment: start;
                        for f in [{ n: "Notes.md", i: "file-text" }, { n: "Plan.pdf", i: "file" }, { n: "Photo.png", i: "image" }, { n: "Song.mp3", i: "music" }]: VerticalLayout {
                            spacing: 6px;
                            width: 100px;
                            Rectangle {
                                height: 84px;
                                border-radius: Radius.m;
                                background: Theme.accent-wash;
                                Icon { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; width: 32px; height: 32px; name: f.i; tint: Theme.accent; }
                            }
                            Caption { text: f.n; color: Theme.text; horizontal-alignment: center; }
                        }
                    }
                }
            }
        }
    }
}

// ------------------------------------------------------------------ Type
export component Typography inherits Page {
    title: "Type";
    note: "Inter for the interface, JetBrains Mono for code. Title 28/700, Heading 20/600, Body 14/400, Caption 12/400.";
    width: 900px;
    height: 560px;
    VerticalLayout {
        spacing: 16px;
        alignment: start;
        Title { text: "Title 28 — The quick plum fox"; }
        Heading { text: "Heading 20 — The quick plum fox"; }
        BodyStrong { text: "Body strong 14 — The quick plum fox jumps over the lazy dog"; }
        Body { text: "Body 14 — The quick plum fox jumps over the lazy dog. Malva is the colour of the flower and of the tea."; }
        Label { text: "Label 13 — Button text, field labels"; }
        Caption { text: "Caption 12 — Hints, timestamps, footnotes"; }
        Code { text: "Code 13 — let accent = Theme.accent;  // JetBrains Mono"; }
        Divider { }
        HorizontalLayout {
            spacing: 14px;
            alignment: start;
            for c in [{ n: "Petal", c: Palette.petal }, { n: "Lilac", c: Palette.lilac }, { n: "Orchid", c: Palette.orchid }, { n: "Plum", c: Palette.plum }, { n: "Leaf", c: Palette.leaf }]: VerticalLayout {
                spacing: 6px;
                Rectangle { width: 110px; height: 64px; border-radius: Radius.m; background: c.c; }
                Label { text: c.n; }
            }
        }
        HorizontalLayout {
            spacing: 24px;
            alignment: start;
            Logo { kind: "horizontal"; reverse: Theme.dark; height: 44px; width: 200px; }
            Logo { kind: "mark"; reverse: Theme.dark; height: 44px; width: 44px; }
            Logo { kind: "app"; height: 44px; width: 44px; }
        }
    }
}
