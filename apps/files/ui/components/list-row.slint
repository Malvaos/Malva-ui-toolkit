import { Theme, Motion } from "../theme.slint";
import { FileEntry } from "../types.slint";
import { SelectionCard, HoverPlate } from "surfaces.slint";
import { KindIcon } from "icon.slint";

// The columns of the list, shared by its rows and its heading so they line up.
export global ListColumns {
    out property <length> modified: 150px;
    out property <length> size: 90px;
    out property <length> kind: 140px;
    out property <length> row-height: 34px;
    out property <length> side: 12px;
}

// One row of the list view: a small icon, the name, and the facts about it. The selection is the
// sidebar's pill, wide; the pointer's plate fades in under it.
export component ListRow inherits Rectangle {
    in property <FileEntry> entry;
    in property <int> index: 0;
    // Every other row has a faint band, for the eye to follow a row across.
    in property <bool> banded: false;
    in property <bool> entering: false;
    in property <bool> force-hover: false;

    callback pressed(bool, bool);
    callback activated();
    callback context(length, length);

    property <bool> hovered: ta.has-hover || force-hover;
    property <float> hover: hovered && !entry.selected ? 1 : 0;
    animate hover {
        duration: hovered ? Motion.hover-in : Motion.hover-out;
        easing: cubic-bezier(0.4, 0, 0.2, 1);
    }
    property <float> select: entry.selected ? 1 : 0;
    animate select {
        duration: Motion.select;
        easing: entry.selected ? cubic-bezier(0.34, 1.35, 0.64, 1) : cubic-bezier(0.4, 0, 1, 1);
    }
    property <bool> arrived: false;
    property <float> enter: arrived ? 1 : 0;
    animate enter {
        duration: root.entering ? Motion.enter : 0ms;
        delay: root.entering ? min(root.index, Motion.stagger-limit) * Motion.stagger : 0ms;
        easing: cubic-bezier(0.2, 0, 0, 1);
    }
    init => {
        root.arrived = true;
    }

    height: ListColumns.row-height;
    z: entry.selected ? 1 : 0;

    body := Rectangle {
        opacity: root.enter * (root.entry.hidden ? 0.5 : 1.0);
        x: (1.0 - root.enter) * -8px;

        Rectangle {
            border-radius: Theme.radius-medium;
            background: root.banded ? Theme.alternate-row : transparent;
        }

        HoverPlate {
            corner: Theme.radius-medium;
            amount: root.hover;
        }

        SelectionCard {
            pill: true;
            corner: Theme.radius-medium;
            amount: root.select;
        }

        KindIcon {
            x: 12px;
            y: (parent.height - 20px) / 2;
            width: 20px;
            height: 20px;
            kind: root.entry.kind;
        }

        Text {
            x: 44px;
            width: parent.width - 44px - ListColumns.modified - ListColumns.size - ListColumns.kind - 8px;
            height: parent.height;
            text: root.entry.name;
            color: Theme.text;
            font-size: Theme.font-size;
            vertical-alignment: center;
            overflow: elide;
        }

        Text {
            x: parent.width - ListColumns.modified - ListColumns.size - ListColumns.kind;
            width: ListColumns.modified - 8px;
            height: parent.height;
            text: root.entry.modified;
            color: Theme.disabled;
            font-size: Theme.font-size;
            vertical-alignment: center;
            overflow: elide;
        }

        Text {
            x: parent.width - ListColumns.size - ListColumns.kind;
            width: ListColumns.size - 16px;
            height: parent.height;
            text: root.entry.size;
            color: Theme.disabled;
            font-size: Theme.font-size;
            horizontal-alignment: right;
            vertical-alignment: center;
            overflow: elide;
        }

        Text {
            x: parent.width - ListColumns.kind + 8px;
            width: ListColumns.kind - 20px;
            height: parent.height;
            text: root.entry.kind-label;
            color: Theme.disabled;
            font-size: Theme.font-size;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    ta := TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                if (e.button == PointerEventButton.left) {
                    root.pressed(e.modifiers.control, e.modifiers.shift);
                } else if (e.button == PointerEventButton.right) {
                    root.context(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                }
            }
        }
        double-clicked => {
            root.activated();
        }
    }
}
