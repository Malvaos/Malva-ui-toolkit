import { Theme, Motion } from "../theme.slint";
import { Symbol } from "icon.slint";
import { Spinner } from "controls.slint";

// A vertical scroll area: the wheel scrolls it, and a thin thumb shows there is more.
export component Scroller inherits Rectangle {
    // How tall everything inside is.
    in property <length> inner-height;
    out property <length> scroll: -fl.content-y;
    clip: true;

    fl := Flickable {
        width: parent.width;
        height: parent.height;
        content-width: parent.width;
        content-height: max(root.inner-height, parent.height);
        interactive: false;
        @children
    }
    Rectangle {
        property <bool> needed: root.inner-height > root.height + 1px;
        x: parent.width - 5px;
        y: 2px + (parent.height - 4px - self.height) * (-fl.content-y / max(root.inner-height - root.height, 1px));
        width: 3px;
        height: max(24px, (parent.height - 4px) * root.height / max(root.inner-height, 1px));
        border-radius: 1.5px;
        background: Theme.text.with-alpha(0.30);
        opacity: needed ? 1 : 0;
    }
}

// One row of a list in a popover: a chip with a symbol, a title, a line beneath, and something at the
// end (a tick, a lock, a spinner, a figure).
export component ListRow inherits Rectangle {
    in property <string> icon;
    in property <string> title;
    in property <string> subtitle;
    // The chip is filled with the accent (the thing in use).
    in property <bool> active: false;
    // "", "check", "lock", "spinner", "text"
    in property <string> trailing: "";
    in property <string> trailing-text;
    in property <bool> chip: true;
    in property <bool> enabled: true;
    in property <bool> force-hover: false;
    callback clicked();

    property <float> hover: (ta.has-hover || force-hover) && enabled ? 1 : 0;
    animate hover { duration: ta.has-hover ? Motion.hover-in : Motion.hover-out; }

    height: subtitle != "" ? 46px : 40px;
    border-radius: Theme.radius-medium;
    opacity: enabled ? 1.0 : 0.45;
    background: Theme.text.with-alpha(root.hover * Theme.plate-alpha * 1.3 + (ta.pressed ? 0.03 : 0.0));

    if root.chip: Rectangle {
        x: 8px;
        y: (parent.height - self.height) / 2;
        width: 30px;
        height: 30px;
        border-radius: 15px;
        background: root.active ? Theme.accent : Theme.field;
        Symbol {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 17px;
            height: 17px;
            name: root.icon;
            tint: root.active ? Theme.on-accent : Theme.text;
        }
    }
    Text {
        x: root.chip ? 48px : 12px;
        y: root.subtitle != "" ? 7px : (parent.height - self.height) / 2;
        width: parent.width - self.x - 40px;
        text: root.title;
        color: Theme.text;
        font-size: 13.5px;
        font-weight: root.active ? 600 : 500;
        overflow: elide;
    }
    if root.subtitle != "": Text {
        x: root.chip ? 48px : 12px;
        y: 25px;
        width: parent.width - self.x - 40px;
        text: root.subtitle;
        color: root.active ? Theme.accent : Theme.text-2;
        font-size: 11.5px;
        overflow: elide;
    }
    if root.trailing == "check": Symbol {
        x: parent.width - 28px;
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 16px;
        name: "check";
        tint: Theme.accent;
    }
    if root.trailing == "lock": Symbol {
        x: parent.width - 26px;
        y: (parent.height - self.height) / 2;
        width: 14px;
        height: 14px;
        name: "lock";
        tint: Theme.text-3;
    }
    if root.trailing == "spinner": Spinner {
        x: parent.width - 28px;
        y: (parent.height - self.height) / 2;
        tint: Theme.accent;
    }
    if root.trailing == "text": Text {
        x: parent.width - self.preferred-width - 12px;
        y: (parent.height - self.height) / 2;
        text: root.trailing-text;
        color: Theme.text-2;
        font-size: 12px;
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => {
            root.clicked();
        }
    }
}

// A line of small print that names a group of rows.
export component SectionLabel inherits Text {
    color: Theme.text-3;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.4px;
    height: 24px;
    vertical-alignment: bottom;
}

// A quiet text row at the foot of a popover ("Wi-Fi Settings…").
export component FootLink inherits Rectangle {
    in property <string> text;
    in property <string> icon: "gear";
    callback clicked();
    property <float> hover: ta.has-hover ? 1 : 0;
    animate hover { duration: ta.has-hover ? Motion.hover-in : Motion.hover-out; }
    height: 34px;
    border-radius: Theme.radius-medium;
    background: Theme.text.with-alpha(root.hover * Theme.plate-alpha * 1.3);
    Symbol {
        x: 12px;
        y: (parent.height - self.height) / 2;
        width: 15px;
        height: 15px;
        name: root.icon;
        tint: Theme.text-2;
    }
    Text {
        x: 36px;
        height: parent.height;
        width: parent.width - 48px;
        text: root.text;
        color: Theme.text;
        font-size: 13px;
        vertical-alignment: center;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

export component Rule inherits Rectangle {
    height: 1px;
    background: Theme.separator;
}
