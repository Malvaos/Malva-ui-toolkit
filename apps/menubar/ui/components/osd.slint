import { Theme, Motion } from "../theme.slint";
import { Symbol } from "icon.slint";
import { GlassPlate } from "surfaces.slint";

// The on-screen display for volume, brightness and the like: a square of glass with the symbol and a
// row of sixteen steps. It shows for a moment after `show(...)` and goes by itself; showing again while
// it is up keeps it up and moves the steps.
export component Osd inherits Rectangle {
    // "volume", "brightness", "mute" or "text" (a word or two big, no steps: the layout's name)
    in-out property <string> kind: "volume";
    in-out property <float> value: 0.5;
    in-out property <string> label: "";
    // For design previews: drawn showing.
    in property <bool> preview-shown: false;
    out property <bool> showing: shown || preview-shown;

    property <bool> shown: false;
    property <float> amount: showing ? 1 : 0;
    animate amount {
        duration: showing ? Motion.osd-in : Motion.osd-out;
        easing: showing ? cubic-bezier(0.34, 1.35, 0.64, 1) : cubic-bezier(0.4, 0, 0.2, 1);
    }
    property <float> level: min(max(value, 0.0), 1.0);
    animate level { duration: 90ms; easing: ease-out; }

    public function show(kind: string, value: float, label: string) {
        root.kind = kind;
        root.value = value;
        root.label = label;
        root.shown = true;
        life.restart();
    }
    life := Timer {
        interval: Motion.osd-life;
        running: root.shown;
        triggered => {
            root.shown = false;
        }
    }

    width: 176px;
    height: 176px;
    visible: amount > 0.01;
    opacity: min(amount, 1.0);
    transform-scale: 0.9 + 0.1 * min(amount, 1.1);

    GlassPlate {
        width: parent.width;
        height: parent.height;
        corner: 30px;
    }
    if root.kind != "text": Symbol {
        x: (parent.width - self.width) / 2;
        y: 30px;
        width: 66px;
        height: 66px;
        name: root.kind == "brightness" ? "sun" : root.kind == "mute" || root.value <= 0.001 ? "volume-mute" : root.value < 0.34 ? "volume-1" : root.value < 0.67 ? "volume-1" : "volume-2";
        tint: Theme.text;
    }
    if root.kind == "text": Text {
        y: 38px;
        width: parent.width;
        text: root.label;
        horizontal-alignment: center;
        font-size: 46px;
        font-weight: 700;
        color: Theme.text;
    }
    if root.kind != "text": Text {
        y: 106px;
        width: parent.width;
        text: root.label;
        horizontal-alignment: center;
        font-size: 12.5px;
        color: Theme.text-2;
    }
    // sixteen steps
    for i in 16: Rectangle {
        x: 20px + i * 8.5px;
        y: 134px;
        width: 6px;
        height: 8px;
        border-radius: 2px;
        background: Theme.text.with-alpha(root.kind != "text" && i + 0.5 < root.level * 16 ? 0.92 : 0.18);
        visible: root.kind != "text";
    }
    if root.kind == "text": Text {
        y: 118px;
        width: parent.width;
        text: "Keyboard layout";
        horizontal-alignment: center;
        font-size: 12px;
        color: Theme.text-2;
    }
}
