import { Theme, Motion, Screen } from "../theme.slint";
import { TrayItem } from "../types.slint";
import { Symbol } from "icon.slint";
import { BatteryGlyph, WifiGlyph, VolumeGlyph } from "glyphs.slint";

// One thing on the bar that can open something: a menu title, a status icon, the clock. It lights
// under the pointer, stays lit while what it opened is open, and (while something is open) opens its
// own thing the moment the pointer arrives, so a sweep along the bar walks through the menus.
export component BarItem inherits Rectangle {
    in property <string> name;
    // Its place along the bar, from the left (the system menu is 0): how the keyboard walks it.
    in property <int> index: 0;
    // What the window has open right now ("" for nothing).
    in property <string> open-name;
    // Keyboard moves along the bar: the item at nav-index opens when nav-nonce changes.
    in property <int> nav-index: -1;
    in property <int> nav-nonce: 0;
    in property <length> pad: 8px;
    // For design previews.
    in property <bool> force-hover: false;
    in property <bool> force-open: false;
    out property <length> center-x: self.absolute-position.x + self.width / 2;
    // Called when this item should open: its name, its place, its centre and its left edge, in window coordinates.
    callback activated(string, int, length, length);
    // Called when the person presses it (the window decides between opening and closing).
    callback pressed(string, int, length, length);

    property <bool> open: open-name == name || force-open;
    property <bool> hovering: ta.has-hover;
    property <float> plate: open ? Theme.item-open : (hovering || force-hover ? Theme.item-hover : 0.0);
    animate plate { duration: hovering ? Motion.hover-in : Motion.hover-out; }

    changed hovering => {
        if self.hovering && root.open-name != "" && root.open-name != root.name {
            root.activated(root.name, root.index, root.absolute-position.x + root.width / 2, root.absolute-position.x);
        }
    }
    changed nav-nonce => {
        if root.nav-index == root.index {
            root.activated(root.name, root.index, root.absolute-position.x + root.width / 2, root.absolute-position.x);
        }
    }

    height: 24px;
    preferred-width: content.preferred-width;
    horizontal-stretch: 0;
    max-width: content.preferred-width;
    border-radius: 7px;
    background: Theme.text.with-alpha(plate);
    transform-scale: ta.pressed ? 0.96 : 1.0;
    animate transform-scale { duration: Motion.press; }

    content := HorizontalLayout {
        padding-left: root.pad;
        padding-right: root.pad;
        spacing: 6px;
        alignment: center;
        @children
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.pressed(root.name, root.index, root.absolute-position.x + root.width / 2, root.absolute-position.x);
        }
    }
}

// The bar: a strip of glass along the top. On the left the system menu and the menus of the app
// in front; on the right the tray, the status icons, the Control Center, the bell and the clock.
export component MenuBar inherits Rectangle {
    // ---- what to show ----
    // The titles of the menus; the first is the app's name, drawn bold.
    in property <[string]> menus;
    in property <[TrayItem]> tray;
    in property <string> layout-text: "";
    in property <bool> bluetooth-enabled: true;
    in property <int> bluetooth-connected: 0;
    in property <bool> wifi-enabled: true;
    in property <bool> wifi-connected: true;
    in property <int> wifi-strength: 3;
    in property <float> volume: 0.5;
    in property <bool> muted: false;
    in property <int> battery: 80;
    in property <bool> charging: false;
    in property <bool> show-battery-percent: false;
    in property <bool> has-battery: true;
    in property <bool> dnd: false;
    in property <int> unread: 0;
    in property <string> clock-text: "";
    // ---- what is open ----
    in property <string> open-name;
    in property <int> nav-index: -1;
    in property <int> nav-nonce: 0;
    // For design previews: an item drawn hovered, by name.
    in property <string> preview-hover: "";
    callback activated(string, int, length, length);
    callback pressed(string, int, length, length);

    // Where each item stands from the left, so the keyboard can walk the bar.
    property <int> right-start: 1 + menus.length + tray.length;
    out property <int> layout-index: right-start;
    out property <int> bluetooth-index: right-start + (layout-text != "" ? 1 : 0);
    out property <int> wifi-index: bluetooth-index + 1;
    out property <int> volume-index: wifi-index + 1;
    out property <int> battery-index: volume-index + 1;
    out property <int> control-index: battery-index + (has-battery ? 1 : 0);
    out property <int> bell-index: control-index + 1;
    out property <int> clock-index: bell-index + 1;
    // Where the fixed items are, for a window that opens one without the pointer.
    out property <length> bluetooth-x: bt-item.center-x;
    out property <length> wifi-x: wifi-item.center-x;
    out property <length> volume-x: vol-item.center-x;
    out property <length> control-x: ctl-item.center-x;
    out property <length> bell-x: bell-item.center-x;
    out property <length> clock-x: clock-item.center-x;

    height: Theme.bar-height;

    // Soft shadow under the bar: fading 1 px lines, so the bar's own glass is not tinted.
    for i in 7: Rectangle {
        y: root.height + i * 1px;
        height: 1px;
        background: Theme.shadow.with-alpha(Theme.pop-shadow * 0.14 * (1.0 - i / 7.0) * (1.0 - i / 7.0));
    }
    Rectangle {
        clip: true;
        if Screen.has-backdrop: Image {
            x: -root.absolute-position.x;
            y: -root.absolute-position.y;
            width: Screen.width;
            height: Screen.height;
            source: Screen.backdrop;
            image-fit: fill;
        }
        Rectangle {
            background: @linear-gradient(180deg, Theme.bar-top, Theme.bar-bottom);
        }
        // The hairline under the bar and the light on its top edge.
        Rectangle {
            y: parent.height - 1px;
            height: 1px;
            background: Theme.shadow.with-alpha(Theme.bar-hairline * 0.5);
        }
        Rectangle {
            y: 0px;
            height: 1px;
            background: #FFFFFF.with-alpha(Theme.bar-sheen * 0.55);
        }
    }

    HorizontalLayout {
        x: 0px;
        y: 3px;
        width: parent.width;
        height: 24px;
        padding-left: 6px;
        padding-right: 6px;
        spacing: 1px;

        // ---- the system menu ----
        BarItem {
            name: "system";
            index: 0;
            open-name: root.open-name;
            nav-index: root.nav-index;
            nav-nonce: root.nav-nonce;
            pad: 9px;
            force-hover: root.preview-hover == self.name;
            activated(n, i, c, l) => { root.activated(n, i, c, l); }
            pressed(n, i, c, l) => { root.pressed(n, i, c, l); }
            Symbol {
                y: (parent.height - self.height) / 2;
                width: 17px;
                height: 17px;
                name: "logo";
                tint: Theme.text;
            }
        }
        // ---- the app's menus ----
        for m[i] in root.menus: BarItem {
            name: "menu-" + i;
            index: 1 + i;
            open-name: root.open-name;
            nav-index: root.nav-index;
            nav-nonce: root.nav-nonce;
            force-hover: root.preview-hover == self.name;
            activated(n, i, c, l) => { root.activated(n, i, c, l); }
            pressed(n, i, c, l) => { root.pressed(n, i, c, l); }
            Text {
                text: m;
                color: Theme.text;
                font-size: 13px;
                font-weight: i == 0 ? 700 : 400;
                vertical-alignment: center;
            }
        }

        Rectangle {
            horizontal-stretch: 1;
        }

        // ---- the tray ----
        for t[i] in root.tray: BarItem {
            name: "tray-" + i;
            index: 1 + root.menus.length + i;
            open-name: root.open-name;
            nav-index: root.nav-index;
            nav-nonce: root.nav-nonce;
            pad: 6px;
            force-hover: root.preview-hover == self.name;
            activated(n, i, c, l) => { root.activated(n, i, c, l); }
            pressed(n, i, c, l) => { root.pressed(n, i, c, l); }
            Rectangle {
                width: 17px;
                Symbol {
                    y: (parent.height - self.height) / 2;
                    width: 17px;
                    height: 17px;
                    name: t.icon;
                    tint: t.active ? Theme.accent : Theme.text;
                }
                if t.active: Rectangle {
                    x: parent.width - 6px;
                    y: 3px;
                    width: 6px;
                    height: 6px;
                    border-radius: 3px;
                    background: Theme.accent;
                    border-width: 1px;
                    border-color: Theme.bar-top;
                }
            }
        }
        // ---- the keyboard layout ----
        if root.layout-text != "": BarItem {
            name: "layout";
            index: root.layout-index;
            open-name: root.open-name;
            nav-index: root.nav-index;
            nav-nonce: root.nav-nonce;
            pad: 7px;
            force-hover: root.preview-hover == self.name;
            activated(n, i, c, l) => { root.activated(n, i, c, l); }
            pressed(n, i, c, l) => { root.pressed(n, i, c, l); }
            Text {
                text: root.layout-text;
                color: Theme.text;
                font-size: 12px;
                font-weight: 600;
                letter-spacing: 0.3px;
                vertical-alignment: center;
            }
        }
        bt-item := BarItem {
            name: "bluetooth";
            index: root.bluetooth-index;
            open-name: root.open-name;
            nav-index: root.nav-index;
            nav-nonce: root.nav-nonce;
            pad: 7px;
            force-hover: root.preview-hover == self.name;
            activated(n, i, c, l) => { root.activated(n, i, c, l); }
            pressed(n, i, c, l) => { root.pressed(n, i, c, l); }
            Symbol {
                y: (parent.height - self.height) / 2;
                width: 16px;
                height: 16px;
                name: "bluetooth";
                tint: root.bluetooth-enabled ? Theme.text : Theme.text-3;
            }
        }
        wifi-item := BarItem {
            name: "wifi";
            index: root.wifi-index;
            open-name: root.open-name;
            nav-index: root.nav-index;
            nav-nonce: root.nav-nonce;
            pad: 7px;
            force-hover: root.preview-hover == self.name;
            activated(n, i, c, l) => { root.activated(n, i, c, l); }
            pressed(n, i, c, l) => { root.pressed(n, i, c, l); }
            WifiGlyph {
                y: (parent.height - self.height) / 2;
                width: 17px;
                height: 17px;
                enabled: root.wifi-enabled;
                connected: root.wifi-connected;
                strength: root.wifi-strength;
                tint: root.wifi-enabled ? Theme.text : Theme.text-3;
            }
        }
        vol-item := BarItem {
            name: "volume";
            index: root.volume-index;
            open-name: root.open-name;
            nav-index: root.nav-index;
            nav-nonce: root.nav-nonce;
            pad: 7px;
            force-hover: root.preview-hover == self.name;
            activated(n, i, c, l) => { root.activated(n, i, c, l); }
            pressed(n, i, c, l) => { root.pressed(n, i, c, l); }
            VolumeGlyph {
                y: (parent.height - self.height) / 2;
                width: 17px;
                height: 17px;
                level: root.volume;
                muted: root.muted;
                tint: root.muted ? Theme.text-3 : Theme.text;
            }
        }
        if root.has-battery: BarItem {
            name: "battery";
            index: root.battery-index;
            open-name: root.open-name;
            nav-index: root.nav-index;
            nav-nonce: root.nav-nonce;
            pad: 7px;
            force-hover: root.preview-hover == self.name;
            activated(n, i, c, l) => { root.activated(n, i, c, l); }
            pressed(n, i, c, l) => { root.pressed(n, i, c, l); }
            BatteryGlyph {
                y: (parent.height - self.height) / 2;
                percent: root.battery;
                charging: root.charging;
                show-percent: root.show-battery-percent;
            }
        }
        ctl-item := BarItem {
            name: "control";
            index: root.control-index;
            open-name: root.open-name;
            nav-index: root.nav-index;
            nav-nonce: root.nav-nonce;
            pad: 7px;
            force-hover: root.preview-hover == self.name;
            activated(n, i, c, l) => { root.activated(n, i, c, l); }
            pressed(n, i, c, l) => { root.pressed(n, i, c, l); }
            Symbol {
                y: (parent.height - self.height) / 2;
                width: 17px;
                height: 17px;
                name: "sliders";
                tint: Theme.text;
            }
        }
        bell-item := BarItem {
            name: "bell";
            index: root.bell-index;
            open-name: root.open-name;
            nav-index: root.nav-index;
            nav-nonce: root.nav-nonce;
            pad: 7px;
            force-hover: root.preview-hover == self.name;
            activated(n, i, c, l) => { root.activated(n, i, c, l); }
            pressed(n, i, c, l) => { root.pressed(n, i, c, l); }
            Rectangle {
                width: 17px;
                Symbol {
                    y: (parent.height - self.height) / 2;
                    width: 17px;
                    height: 17px;
                    name: root.dnd ? "moon" : "bell";
                    tint: Theme.text;
                }
                // Unread: a red dot that pops in.
                Rectangle {
                    property <bool> on: root.unread > 0 && !root.dnd;
                    property <float> a: on ? 1 : 0;
                    animate a { duration: Motion.badge; easing: cubic-bezier(0.34, 1.35, 0.64, 1); }
                    x: parent.width - 7px;
                    y: 2px;
                    width: 8px * a;
                    height: 8px * a;
                    border-radius: 4px * a;
                    background: Theme.badge;
                    border-width: 1.5px;
                    border-color: Theme.bar-top;
                }
            }
        }
        clock-item := BarItem {
            name: "clock";
            index: root.clock-index;
            open-name: root.open-name;
            nav-index: root.nav-index;
            nav-nonce: root.nav-nonce;
            pad: 9px;
            force-hover: root.preview-hover == self.name;
            activated(n, i, c, l) => { root.activated(n, i, c, l); }
            pressed(n, i, c, l) => { root.pressed(n, i, c, l); }
            Text {
                text: root.clock-text;
                color: Theme.text;
                font-size: 12.5px;
                font-weight: 500;
                vertical-alignment: center;
            }
        }
    }
}
