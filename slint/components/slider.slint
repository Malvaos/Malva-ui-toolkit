// A slider: a 6 px track, a 22 px ring-shaped thumb, keyboard and pointer, an optional value bubble.
import { Theme, Size, Radius, Space, Typo, Motion } from "../tokens.slint";
import { FocusRing, ForceState } from "base.slint";

export component Slider inherits Rectangle {
    in-out property <float> value: 0;
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    // 0 means continuous; otherwise the value snaps to multiples of step.
    in property <float> step: 0;
    in property <bool> enabled: true;
    // Show the value in a bubble above the thumb while it is dragged.
    in property <bool> show-value: false;
    in property <ForceState> force: ForceState.none;
    // Called when the person changes the value (not when the code does).
    callback changed(float);

    property <bool> kbd: false;
    property <bool> hot: (ta.has-hover || force == ForceState.hover) && enabled;
    property <bool> down: (ta.pressed || force == ForceState.pressed) && enabled;
    property <float> frac: maximum > minimum ? min(max((value - minimum) / (maximum - minimum), 0.0), 1.0) : 0.0;
    property <float> shown: frac;
    animate shown { duration: ta.pressed ? 0ms : Motion.hover; easing: Motion.curve-out; }
    property <length> thumb: Size.slider-thumb + (hot ? 2px : 0px);
    animate thumb { duration: Motion.hover; easing: Motion.curve-spring; }
    property <length> run: root.width - Size.slider-thumb;

    height: Size.slider-thumb + 4px;
    min-width: 80px;

    function put(x: length) {
        if root.run <= 0px {
            return;
        }
        let f = min(max((x - Size.slider-thumb / 2) / root.run, 0.0), 1.0);
        let raw = root.minimum + f * (root.maximum - root.minimum);
        let v = min(max(root.step > 0 ? round(raw / root.step) * root.step : raw, root.minimum), root.maximum);
        if v != root.value {
            root.value = v;
            root.changed(v);
        }
    }
    function nudge(dir: float) {
        let d = root.step > 0 ? root.step : (root.maximum - root.minimum) / 100;
        let v = min(max(root.value + dir * d, root.minimum), root.maximum);
        if v != root.value {
            root.value = v;
            root.changed(v);
        }
    }

    // the track
    Rectangle {
        y: (parent.height - self.height) / 2;
        x: Size.slider-thumb / 2;
        width: parent.width - Size.slider-thumb;
        height: Size.slider-track;
        border-radius: self.height / 2;
        background: root.enabled ? Theme.track : Theme.line;
        // the filled part
        Rectangle {
            x: 0px;
            y: 0px;
            width: root.shown * parent.width;
            height: parent.height;
            border-radius: parent.border-radius;
            background: root.enabled ? Theme.accent : Theme.accent-disabled;
        }
    }
    // the thumb
    thumb := Rectangle {
        width: root.thumb;
        height: root.thumb;
        x: Size.slider-thumb / 2 + root.shown * root.run - self.width / 2;
        y: (parent.height - self.height) / 2;
        border-radius: self.width / 2;
        background: Theme.surface;
        border-width: 3px;
        border-color: root.enabled ? Theme.accent : Theme.disabled-text;
        drop-shadow-color: #00000026;
        drop-shadow-blur: 3px;
        drop-shadow-offset-y: 1px;
        FocusRing {
            active: root.kbd || root.force == ForceState.focus;
            radius: thumb.border-radius;
            host-width: thumb.width;
            host-height: thumb.height;
        }
        if root.show-value && root.down: Rectangle {
            width: 40px;
            height: 26px;
            x: (parent.width - self.width) / 2;
            y: -self.height - 8px;
            border-radius: Radius.xs + 2px;
            background: Theme.inverse;
            Text {
                text: round(root.value * 10) / 10;
                color: Theme.on-inverse;
                font-family: Typo.ui;
                font-size: Typo.caption-size;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                fs.focus();
                root.put(self.mouse-x);
            }
        }
        moved => {
            if self.pressed {
                root.put(self.mouse-x);
            }
        }
    }
    fs := FocusScope {
        focus-on-click: false;
        enabled: root.enabled;
        focus-gained(reason) => {
            root.kbd = reason == FocusReason.tab-navigation;
        }
        focus-lost => {
            root.kbd = false;
        }
        key-pressed(e) => {
            if !root.enabled {
                return reject;
            }
            if e.text == Key.RightArrow || e.text == Key.UpArrow {
                root.nudge(1);
                return accept;
            }
            if e.text == Key.LeftArrow || e.text == Key.DownArrow {
                root.nudge(-1);
                return accept;
            }
            if e.text == Key.Home {
                root.value = root.minimum;
                root.changed(root.value);
                return accept;
            }
            if e.text == Key.End {
                root.value = root.maximum;
                root.changed(root.value);
                return accept;
            }
            return reject;
        }
    }
    public function take-focus() {
        fs.focus();
    }
}
