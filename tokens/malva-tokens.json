{
  "meta": {
    "name": "Malva",
    "version": "1.0.0",
    "about": "Single source of truth for the Malva design language. tools/gen_tokens.py turns this file into the Slint globals, the C++ header, the Rust crate, the CSS variables, the SVG palette sheet, the DTCG JSON and docs/TOKENS.md. Edit here, regenerate, never edit the outputs.",
    "provenance": {
      "palette": "Surfaces, text and borders are a neutral scale: soft off-white and graphite, as in the system look the user specified (light #F5F5F7 / #FFFFFF / #1D1D1F / #86868B / #E5E5EA; dark #161617 / #1E1E1F / #F5F5F7 / #8E8E93 / #2C2C2E). Nothing neutral is tinted toward the brand.",
      "accent": "The logo's colour (the mark's gradient runs Plum #8C3274 to Orchid #C763B0) is the one strong colour, used the way a black-and-white interface uses its logo's blue: primary actions, selection, focus, the on state of a switch, links. Light mode uses Plum, dark mode the lighter orchid-pink #DC73C2.",
      "brand": "The brand palette (petal, lilac, orchid, plum, leaf, ink) is kept for logos and illustration; interface roles do not use petal, lilac or ink.",
      "danger": "The filled danger button is #C42F3E because white on #D6414F is 4.4:1 and on #C42F3E is 5.5:1 (WCAG AA)."
    },
    "expressions": "A colour is '#RRGGBB', '#RRGGBBAA' or '@fn(args)'. mix(a,b,pct) blends a toward b by an integer percent; alpha(a,pct) sets opacity to pct percent; over(a,b) composites a over b. Names refer to colours of the same mode. All maths is integer, so every language gets the same bytes."
  },
  "brand": {
    "petal": "#E6DAE8",
    "lilac": "#DEC3E0",
    "orchid": "#B84F9F",
    "plum": "#8C3274",
    "leaf": "#274903",
    "ink": "#2A1226"
  },
